# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External Free-Tier Services (Defaults to Built-in Free In-Memory / Local Storage Engine)
# Free PostgreSQL (e.g. Neon, Supabase free tier):
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Free Object Storage (e.g. Supabase Storage, Cloudinary, Cloudflare R2 free tier):
STORAGE_URL="https://your-project.supabase.co/storage/v1"
STORAGE_KEY=""

# Vector Store (e.g. pgvector or in-memory vector index):
VECTOR_DATABASE_URL=""

# Authentication & JWT secret (for standalone self-hosting):
JWT_SECRET="generate-a-secure-random-secret-key-32-chars-minimum"

# Server Port (default 3000):
PORT=3000

# Client Configuration (for Decoupled Vercel Frontend -> Render Backend)
# On Vercel, set this to your Render backend URL (e.g. https://synapse-ai-backend.onrender.com)
VITE_API_URL=""

